{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: Nano ESP32",
      "type": "shell",
      "command": "arduino-cli compile --profile nano_esp32 --build-path build/nano_esp32 .",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build: Pico 2 W",
      "type": "shell",
      "command": "arduino-cli compile --profile pico2w --build-path build/pico2w .",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Upload: Nano ESP32",
      "type": "shell",
      "command": "arduino-cli upload --profile nano_esp32 --input-dir build/nano_esp32 -p ${input:port} .",
      "dependsOn": "Build: Nano ESP32",
      "problemMatcher": []
    },
    {
      "label": "Upload: Pico 2 W (how to)",
      "type": "shell",
      "command": "echo 'Hold BOOTSEL while plugging the Pico 2 W in, then copy build/pico2w/DonutShop.ino.uf2 to the RP2350 drive. (Its USB port is the RT4K host, so there is no serial upload.)'",
      "dependsOn": "Build: Pico 2 W",
      "problemMatcher": []
    }
  ],
  "inputs": [
    { "id": "port", "type": "promptString", "description": "Serial port of the Nano ESP32 (e.g. COM5 or /dev/ttyACM0)" }
  ]
}
