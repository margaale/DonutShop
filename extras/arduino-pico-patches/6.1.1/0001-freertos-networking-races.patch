index 0000000..4e988f3
--- /dev/null
+++ b/libraries/WiFi/src/include/lwip_run.h
@@ -0,0 +1,64 @@
+/*
+    lwip_run.h - Run a block of code atomically with respect to lwIP callbacks
+
+    Copyright (c) 2026 arduino-pico contributors
+
+    This library is free software; you can redistribute it and/or
+    modify it under the terms of the GNU Lesser General Public
+    License as published by the Free Software Foundation; either
