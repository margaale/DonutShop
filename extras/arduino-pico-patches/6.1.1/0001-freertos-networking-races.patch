+    Lesser General Public License for more details.
+
+    You should have received a copy of the GNU Lesser General Public
+    License along with this library; if not, write to the Free Software
+    Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+*/
+
+#pragma once
+
+#include <type_traits>
+#include <lwip_wrap.h>
+
+#ifdef __FREERTOS
+extern "C" bool __isLWIPThread();
+#endif
+
+// ClientContext, UdpContext and WiFiServer keep state (pcb pointers, receive pbuf chains,
+// accept queues) that their lwIP callbacks also modify. Under FreeRTOS those callbacks run in
+// the LWIP task, possibly on the other core, while the application task uses the same objects,
+// so each wrapped lwIP call being atomic is not enough: a check-then-act on that state can
+// interleave with a callback (e.g. abort() on a pcb that _error() just freed).
+//
+// lwip_run(f) executes f() inside the LWIP task (synchronously, returning its result), so it
+// cannot interleave with any lwIP callback. f() must not block or wait for lwIP progress.
+// Without FreeRTOS, or when already in the LWIP task, f() is simply called.
+template <typename F>
+inline auto lwip_run(F&& f) -> decltype(f()) {
+    using R = decltype(f());
+    using Fn = typename std::remove_reference<F>::type;
+#ifdef __FREERTOS
+    if (!__isLWIPThread()) {
+        if constexpr (std::is_void<R>::value) {
+            lwip_callback([](void* p) {
+                (*static_cast<Fn*>(p))();
+            }, static_cast<void*>(&f));
+            return;
+        } else {
+            struct Call {
+                Fn* fn;
+                R ret;
+            } call{&f, R{}};
+            lwip_callback([](void* p) {
+                Call* c = static_cast<Call*>(p);
+                c->ret = (*c->fn)();
+            }, static_cast<void*>(&call));
+            return call.ret;
+        }
+    }
+#endif
+    return f();
+}
